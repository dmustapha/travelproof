default: &default
  rpcs:
    - chain-name: ethereum-testnet-sepolia-base-1
      # cre does NOT expand ${env} — paste a LITERAL Base Sepolia RPC URL here (e.g. your Alchemy key).
      # Copy this file to project.yaml (gitignored) before running `cre workflow simulate`.
      url: https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
staging-settings: *default
production-settings: *default
